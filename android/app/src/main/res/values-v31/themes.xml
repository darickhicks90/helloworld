<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FoxBox" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:colorPrimary">@color/brown</item>
        <item name="android:colorAccent">@color/orange</item>
        <item name="android:statusBarColor">@color/brown</item>
        <item name="android:navigationBarColor">@color/brown_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowSplashScreenBackground">@color/cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/aqua</item>
    </style>
</resources>
